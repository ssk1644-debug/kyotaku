{
  "name": "居宅営業管理システム",
  "short_name": "居宅営業",
  "start_url": "/kyotaku/",
  "scope": "/kyotaku/",
  "display": "standalone",
  "background_color": "#f3f5f4",
  "theme_color": "#0d6e62",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/kyotaku/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "audio", "accept": ["audio/*", ".m4a", ".mp3", ".amr", ".3gp"] } ] }
  }
}
